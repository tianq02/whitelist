#!/usr/bin/env python3
import ipaddress
import sys
import argparse

def load_cidrs(file_path):
    try:
        with open(file_path, "r") as f:
            lines = f.readlines()
        nets = [ipaddress.ip_network(line.strip(), strict=False) for line in lines if line.strip()]
        return list(ipaddress.collapse_addresses(nets))
    except FileNotFoundError:
        print(f"错误: 找不到文件 '{file_path}'", file=sys.stderr)
        sys.exit(1)

def get_added_cidrs(merged_nets, original_nets):
    current_nets = merged_nets.copy()
    for orig in original_nets:
        next_nets = []
        for base in current_nets:
            if not base.overlaps(orig):
                next_nets.append(base)
            elif orig.supernet_of(base) or orig == base:
                pass 
            elif base.supernet_of(orig):
                next_nets.extend(list(base.address_exclude(orig)))
        current_nets = next_nets
    return list(ipaddress.collapse_addresses(current_nets))

def main():
    parser = argparse.ArgumentParser(description="CIDR 合并验证工具：计算合并后额外暴露的 IP 网段及数量。")
    parser.add_argument("original", help="原始 IP 列表文件路径")
    parser.add_argument("merged", help="合并后的 IP 列表文件路径")
    parser.add_argument("-d", "--dump", help="将额外引入的 CIDR 保存到指定文件中")
    parser.add_argument("-q", "--quiet", action="store_true", help="静默模式：只输出额外引入的 IP 数量")
    
    args = parser.parse_args()

    orig_nets = load_cidrs(args.original)
    orig_ip_count = sum(net.num_addresses for net in orig_nets)
    
    merged_nets = load_cidrs(args.merged)
    merged_ip_count = sum(net.num_addresses for net in merged_nets)
    
    added_nets = get_added_cidrs(merged_nets, orig_nets)
    added_ip_count = sum(net.num_addresses for net in added_nets)

    if args.quiet:
        # 静默模式下只输出数字，方便其他 shell 脚本直接获取数值
        print(added_ip_count)
    else:
        print("=" * 40)
        print("【统计信息】")
        print(f"原始白名单 IP 总数 : {orig_ip_count}")
        print(f"合并后规则 IP 总数 : {merged_ip_count}")
        print(f"额外引入的 IP 总数 : {added_ip_count}")
        
        if orig_ip_count + added_ip_count == merged_ip_count:
            print("✅ 数据校验通过: 原始IP + 额外引入IP = 合并后IP")
        else:
            print("❌ 数据校验失败，请检查网段包含关系！")
        print("=" * 40)
        
        if not args.dump:
            print("【额外引入的非白名单 CIDR】:")
            for net in added_nets:
                print(net)

    if args.dump:
        with open(args.dump, "w") as f:
            for net in added_nets:
                f.write(str(net) + "\n")
        if not args.quiet:
            print(f"[*] 额外引入的 CIDR 已保存至: {args.dump}")

if __name__ == "__main__":
    main()
